      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-460, 0],
      "webhookId": "recordatorio_datos_incompletos",
      "notes": "Recibe POST del endpoint /api/recordatorio-datos-incompletos. Responde 200 al instante para que la app marque Recordatorio=true."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Normaliza la entrada: el body puede llegar como array raíz o como { body: [...] }.\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  let arr = null;\n  if (Array.isArray(j)) arr = j;\n  else if (j && Array.isArray(j.body)) arr = j.body;\n  if (arr) {\n    for (const el of arr) out.push({ json: el });\n  } else {\n    out.push({ json: j });\n  }\n}\nreturn out;"
      },
      "id": "a1f0c1a0-0002-4000-8000-000000000002",
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-260, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-email",
              "leftValue": "={{ $json.Canales }}",
              "rightValue": "email",
              "operator": {
